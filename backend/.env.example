# ==================================================
# SedatOS AI Enterprise Backend Configuration
# ==================================================

# Application
APP_NAME=SedatOS AI
APP_VERSION=1.0.0
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Region
APP_REGION=global
APP_TIMEZONE=UTC
APP_LOCALE=en

# Debug
DEBUG=true
LOG_LEVEL=debug
MAINTENANCE_MODE=false

# Security
JWT_SECRET=CHANGE_THIS_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sedatos_ai

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AI
AI_ENABLED=true

# Metrics
METRICS_ENABLED=true
